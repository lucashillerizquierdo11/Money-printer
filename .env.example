# Data provider selection for the World Cup Streak Value Finder.
#
# The app runs fully on built-in mock data with no configuration. To pull real
# World Cup fixtures and results, pick a provider and supply its credentials.

# Which provider to use. Options: "mock" (default) or "football-data".
# If unset, the first *configured* real provider wins, otherwise mock is used.
DATA_PROVIDER=football-data

# football-data.org v4 API key (free tier covers the World Cup competition).
# Register: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
