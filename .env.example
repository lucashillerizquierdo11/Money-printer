# Data provider selection for the World Cup Streak Value Finder.
#
# The app runs fully on built-in mock data with no configuration. To pull real
# World Cup data, pick a provider and supply its credentials. The dashboard's
# edge/EV columns are computed against whichever provider is active.

# Which provider to use. Options:
#   mock           built-in generators (default)
#   api-football   live fixtures + results + corners/cards + odds (recommended)
#   odds-api       bookmaker odds overlaid onto the model's stats
#   football-data  live fixtures + results only (no odds → no edges)
# If unset, the first *configured* real provider wins, otherwise mock is used.
DATA_PROVIDER=api-football

# --- API-Football (api-sports.io) — the live workhorse ---------------------
# Free/paid key: https://www.api-football.com/
API_FOOTBALL_KEY=
# World Cup season year (defaults to 2026).
API_FOOTBALL_SEASON=2026

# --- The Odds API (the-odds-api.com) — odds overlay -----------------------
# Free key: https://the-odds-api.com/
ODDS_API_KEY=
# Sport key (defaults to soccer_fifa_world_cup).
ODDS_API_SPORT=soccer_fifa_world_cup

# --- football-data.org — fixtures/results only ----------------------------
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
